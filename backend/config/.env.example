# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI (Replace with your actual Atlas cluster string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/water_monitoring?retryWrites=true&w=majority

# Local SQLite Database Path (Automatic fallback)
DB_FILE=./db/water_monitoring.sqlite

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# IoT Telemetry Simulator
SIMULATOR_INTERVAL_MS=10000
ENABLE_AUTO_SIMULATOR=true

# SMS Gateway Settings
SMS_GATEWAY_PROVIDER=Fast2SMS
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=JHPHED
EMERGENCY_HELPLINE=1800-345-6555

# Indian Voice TTS (Google Cloud Text-to-Speech)
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here
TTS_DEFAULT_VOICE_HINDI=hi-IN-Neural2-A
TTS_DEFAULT_VOICE_ENGLISH=en-IN-Neural2-B
